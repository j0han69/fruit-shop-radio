# Скопируйте этот файл в .env и заполните.
# В .env кладутся ТОЛЬКО публичные значения: всё с префиксом EXPO_PUBLIC_
# попадает внутрь приложения и видно любому, кто его распакует.
# Секреты (service_role, ключ ЮKassa, ADMIN_PIN) — только в Supabase Secrets!

# Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase → Project Settings → API Keys → publishable (sb_publishable_...) или legacy anon key
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Аудиопоток (Icecast / Radio.co)
EXPO_PUBLIC_STREAM_URL=https://example.com/stream.mp3
# Метаданные: Icecast → https://host:8000/status-json.xsl ; Radio.co → https://public.radio.co/stations/<id>/status
EXPO_PUBLIC_METADATA_URL=
# Только для Icecast с несколькими маунтами, например /live
EXPO_PUBLIC_ICECAST_MOUNT=
