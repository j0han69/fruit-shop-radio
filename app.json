{
  "expo": {
    "name": "Фруктовая лавка",
    "slug": "fruktovaya-lavka-radio",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fruktovaya-lavka",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF7E8",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.fruktovayalavka",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio",
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.example.fruktovayalavka",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF623E"
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-font"
    ]
  }
}
